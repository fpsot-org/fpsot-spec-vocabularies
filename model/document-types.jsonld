          "@id": "https://data.example.org/vocabularies/document-types/concepts/building-permit"
        },
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/certificate"
        },
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/permit"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Documents for businesses"
        },
        {
          "@language": "fr",
          "@value": "Documents pour les entreprises"
        }
      ]
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/concepts/authorization",
      "@type": "skos:Concept",
      "dct:isReplacedBy": {
        "@id": "https://data.example.org/vocabularies/document-types/concepts/permit"
      },
      "dct:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-05"
      },
      "owl:deprecated": true,
      "skos:changeNote": [
        {
          "@language": "en",
          "@value": "2026-11-05, 1.1.0: Deprecated. It had the same meaning as Permit."
        },
        {
          "@language": "fr",
          "@value": "2026-11-05, 1.1.0 : Concept déconseillé. Il avait le même sens que Permis."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A document that allows an action. Replaced by Permit."
        },
        {
          "@language": "fr",
          "@value": "Document qui permet une action. Remplacé par Permis."
        }
      ],
      "skos:inScheme": {
        "@id": "https://data.example.org/vocabularies/document-types"
      },
      "skos:notation": "authorization",
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Authorization"
        },
        {
          "@language": "fr",
          "@value": "Autorisation"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://data.example.org/vocabularies/document-types"
      }
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/concepts/building-permit",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Construction permit"
        },
        {
          "@language": "fr",
          "@value": "Permis de bâtir"
        }
      ],
      "skos:broader": {
        "@id": "https://data.example.org/vocabularies/document-types/concepts/permit"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A permit to build, enlarge or demolish a building."
        },
        {
          "@language": "fr",
          "@value": "Permis qui permet de construire, d’agrandir ou de démolir un bâtiment."
        }
      ],
      "skos:inScheme": {
        "@id": "https://data.example.org/vocabularies/document-types"
      },
      "skos:notation": "building-permit",
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Building permit"
        },
        {
          "@language": "fr",
          "@value": "Permis de construction"
        }
      ]
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/concepts/certificate",
      "@type": "skos:Concept",
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A document that confirms a fact, such as a birth or a qualification. It allows nothing by itself."
        },
        {
          "@language": "fr",
          "@value": "Document qui atteste un fait, comme une naissance ou une qualification. Il ne permet rien par lui-même."
        }
      ],
      "skos:inScheme": {
        "@id": "https://data.example.org/vocabularies/document-types"
      },
      "skos:notation": "certificate",
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Certificate"
        },
        {
          "@language": "fr",
          "@value": "Certificat"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://data.example.org/vocabularies/document-types"
      }
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/concepts/decision",
      "@type": "skos:Concept",
      "dct:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-05"
      },
      "skos:changeNote": [
        {
          "@language": "en",
          "@value": "2026-11-05, 1.1.0: Close match to the EU resource type Decision added."
        },
        {
          "@language": "fr",
          "@value": "2026-11-05, 1.1.0 : Correspondance proche avec le type de ressource Décision de l’UE ajoutée."
        }
      ],
      "skos:closeMatch": {
        "@id": "http://publications.europa.eu/resource/authority/resource-type/DEC"
      },
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A document that gives the answer of a public body to a request, with its reasons."
        },
        {
          "@language": "fr",
          "@value": "Document qui donne la réponse d’un organisme public à une demande, avec ses motifs."
        }
      ],
      "skos:inScheme": {
        "@id": "https://data.example.org/vocabularies/document-types"
      },
      "skos:notation": "decision",
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Decision"
        },
        {
          "@language": "fr",
          "@value": "Décision"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://data.example.org/vocabularies/document-types"
      }
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/concepts/notice",
      "@type": "skos:Concept",
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A document that informs a person of a fact or of a coming action. It decides nothing."
        },
        {
          "@language": "fr",
          "@value": "Document qui informe une personne d’un fait ou d’une action à venir. Il ne décide rien."
        }
      ],
      "skos:inScheme": {
        "@id": "https://data.example.org/vocabularies/document-types"
      },
      "skos:notation": "notice",
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Notice"
        },
        {
          "@language": "fr",
          "@value": "Avis"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://data.example.org/vocabularies/document-types"
      }
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/concepts/permit",
      "@type": "skos:Concept",
      "dct:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-05"
      },
      "dct:replaces": {
        "@id": "https://data.example.org/vocabularies/document-types/concepts/authorization"
      },
      "skos:changeNote": [
        {
          "@language": "en",
          "@value": "2026-11-05, 1.1.0: Replaces Authorization."
        },
        {
          "@language": "fr",
          "@value": "2026-11-05, 1.1.0 : Remplace Autorisation."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "A document that allows a person or a business to do something that the law controls."
        },
        {
          "@language": "fr",
          "@value": "Document qui permet à une personne ou à une entreprise de faire une chose que la loi encadre."
        }
      ],
      "skos:inScheme": {
        "@id": "https://data.example.org/vocabularies/document-types"
      },
      "skos:narrower": {
        "@id": "https://data.example.org/vocabularies/document-types/concepts/building-permit"
      },
      "skos:notation": "permit",
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Permit"
        },
        {
          "@language": "fr",
          "@value": "Permis"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://data.example.org/vocabularies/document-types"
      }
    }
  ]
}
