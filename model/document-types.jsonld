      },
      "dct:modified": {
        "@type": "xsd:date",
        "@value": "2026-11-05"
      },
      "dct:publisher": {
        "@id": "https://data.example.org/"
      },
      "dct:references": {
        "@id": "http://publications.europa.eu/resource/authority/resource-type"
      },
      "owl:versionInfo": "1.1.0",
      "skos:changeNote": [
        {
          "@language": "en",
          "@value": "2026-11-05, 1.1.0: Mappings checked against the EU resource type table, release 20260923-0."
        },
        {
          "@language": "fr",
          "@value": "2026-11-05, 1.1.0 : Correspondances vérifiées avec la table des types de ressources de l’UE, version 20260923-0."
        }
      ],
      "skos:definition": [
        {
          "@language": "en",
          "@value": "Kinds of documents that a public body issues to a person or a business."
        },
        {
          "@language": "fr",
          "@value": "Genres de documents qu’un organisme public délivre à une personne ou à une entreprise."
        }
      ],
      "skos:hasTopConcept": [
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/authorization"
        },
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/certificate"
        },
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/decision"
        },
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/notice"
        },
        {
          "@id": "https://data.example.org/vocabularies/document-types/concepts/permit"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Document types"
        },
        {
          "@language": "fr",
          "@value": "Types de documents"
        }
      ],
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Open list: a minor release can add concepts."
        },
        {
          "@language": "fr",
          "@value": "Liste ouverte : une version mineure peut ajouter des concepts."
        }
      ]
    },
    {
      "@id": "https://data.example.org/vocabularies/document-types/collections/business-documents",
      "@type": "skos:Collection",
      "skos:member": [
